@model CQRSPlayerDemo.Models.Player

@{
    var isEdit = Model != null && Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Player" : "Add Player";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit"></i>
                        @ViewData["Title"]
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter player name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShirtNo" class="form-label">Shirt No</label>
                            <input asp-for="ShirtNo" class="form-control" placeholder="Enter shirt number" />
                            <span asp-validation-for="ShirtNo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Appearance" class="form-label"></label>
                            <input asp-for="Appearance" class="form-control" placeholder="Enter number of appearances" />
                            <span asp-validation-for="Appearance" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Goals" class="form-label"></label>
                            <input asp-for="Goals" class="form-control" placeholder="Enter number of goals" />
                            <span asp-validation-for="Goals" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> @(isEdit ? "Update" : "Create")
                            </button>
                            <a asp-action="Index" class="btn btn-dark">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
